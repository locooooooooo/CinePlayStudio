{
  "name": "gameeditor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:electron": "electron-vite dev",
    "dev:web": "tsx server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --config scripts/eslint.config.mjs . --max-warnings=0",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "electron-vite build",
    "build:web": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "stage:media": "node scripts/stage-media-binaries.mjs",
    "verify:packaged-ffprobe": "node scripts/verify-packaged-ffprobe.mjs",
    "dist:win": "npm run stage:media && npm run build && electron-builder --win nsis",
    "clean": "rimraf dist out release"
  },
  "dependencies": {
    "@google/genai": "2.4.0",
    "@tailwindcss/vite": "4.1.14",
    "@vitejs/plugin-react": "5.0.4",
    "@xyflow/react": "12.11.2",
    "archiver": "8.0.0",
    "docx": "9.7.1",
    "dotenv": "17.2.3",
    "electron-log": "5.4.4",
    "express": "4.21.2",
    "fluent-ffmpeg": "2.1.3",
    "jszip": "3.10.1",
    "lucide-react": "0.546.0",
    "motion": "12.23.24",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "vite": "6.2.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.52.0",
    "@types/archiver": "6.0.3",
    "@types/express": "4.17.21",
    "@types/fluent-ffmpeg": "2.1.28",
    "@types/node": "22.14.0",
    "@vitejs/plugin-react": "5.0.4",
    "autoprefixer": "10.4.21",
    "electron": "37.10.2",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "esbuild": "0.25.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "prettier": "3.6.2",
    "rimraf": "6.1.3",
    "tailwindcss": "4.1.14",
    "tsx": "4.21.0",
    "typescript": "5.8.2",
    "typescript-eslint": "8.32.1",
    "vite": "6.2.3",
    "vitest": "3.1.2"
  }
}
